# Supabase 專案設定（伺服器端；不要提交真正的值）
SUPABASE_URL=https://你的專案.supabase.co
SUPABASE_ANON_KEY=你的_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=只放在伺服器端的_service_role_key

# 伺服器端智慧服務；不要把這個 key 放到 supabase-config.js 或前端
OPENAI_API_KEY=你的_openai_api_key
# 可由內容工作流下拉選擇；未選擇時使用這個部署預設值。
# 支援：gpt-5.6-sol、gpt-5.6-terra、gpt-5.6-luna、gpt-5.5、gpt-5.4、gpt-5.4-mini、gpt-4o、gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# 部署後的前端來源，例如 https://app.example.com
APP_ORIGIN=

# Instagram Graph API（只放在部署平台伺服器端）
# 需要一個可查詢 Instagram 專業帳號的 Meta access token，不能放到前端。
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# 省略時使用目前的 Graph API 版本；若 Meta 專案指定其他版本，請明確填入。
INSTAGRAM_API_VERSION=v25.0
# 每個帳號每次同步的分頁大小與最多頁數；預設最多讀取 1,000 筆可取得媒體。
INSTAGRAM_MEDIA_PAGE_SIZE=50
INSTAGRAM_MEDIA_MAX_PAGES=20
# 創作者授權連線（Meta OAuth）；必須在 Meta App 設定相同的 redirect URI。
INSTAGRAM_META_APP_ID=
INSTAGRAM_META_APP_SECRET=
INSTAGRAM_OAUTH_REDIRECT_URI=https://library-treasure-trove.vercel.app/api/instagram-auth
INSTAGRAM_OAUTH_STATE_SECRET=請填入至少32字元的隨機字串
INSTAGRAM_OAUTH_ENCRYPTION_KEY=請填入至少32字元的隨機字串
INSTAGRAM_OAUTH_SCOPES=pages_show_list,instagram_basic,instagram_manage_insights,pages_read_engagement
CRON_SECRET=
